@Library('fraud-pipeline-lib') _

pipeline {
    agent none

    stages {
        stage('Build and test') {
            agent {
                docker {
                    image 'node:22-alpine'
                    args '-v npm-cache:/home/node/.npm'
                }
            }
            steps {
                nodeBuildAndTest(dir: 'frontend')
            }
            post {
                always {
                    nodeBuildAndTestReport(dir: 'frontend')
                }
            }
        }

        stage('Docker build') {
            agent { label 'built-in' }
            steps {
                dockerBuildAndPush(image: 'ghcr.io/diecocan/diecocan-tools-frontend', dir: 'frontend')
            }
        }

        stage('Deploy to staging') {
            agent { label 'built-in' }
            steps {
                deployContainer(
                    name: 'diecocan-tools-frontend-staging',
                    image: "ghcr.io/diecocan/diecocan-tools-frontend:${env.GIT_COMMIT}",
                    ports: '-p 8092:80',
                    envVars: [BACKEND_PORT: '8090']
                )
                verifyHttp(sleepSeconds: 5, urls: [
                    'http://host.docker.internal:8092/',
                    'http://host.docker.internal:8092/v1/owners'
                ])
            }
        }

        stage('Approval') {
            steps {
                approvalGate()
            }
        }

        stage('Deploy to production') {
            agent { label 'built-in' }
            steps {
                deployContainer(
                    name: 'diecocan-tools-frontend-prod',
                    image: "ghcr.io/diecocan/diecocan-tools-frontend:${env.GIT_COMMIT}",
                    ports: '-p 8093:80',
                    envVars: [BACKEND_PORT: '8091']
                )
                verifyHttp(sleepSeconds: 5, urls: [
                    'http://host.docker.internal:8093/',
                    'http://host.docker.internal:8093/v1/owners'
                ])
            }
        }
    }
}
